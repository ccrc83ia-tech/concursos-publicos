# ================================
# Backend - Java / Gradle / Spring
# ================================
backend/.gradle/
backend/build/
backend/target/
backend/out/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Gradle wrapper (mantener gradlew y gradlew.bat, ignorar caché)
!backend/gradle/wrapper/gradle-wrapper.jar
!backend/gradle/wrapper/gradle-wrapper.properties

# Spring Boot / IDE temporales
*.log
spring.log
backend/logs/

# ========================
# Frontend - Node / Vite
# ========================
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

# Variables de entorno (pueden contener secretos)
.env
.env.local
.env.*.local
.env.production

# ========================
# IDEs y editores
# ========================
.idea/
*.iml
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
nbproject/
.classpath
.project
.settings/

# ========================
# Sistema operativo
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# Kiro IDE
# ========================
# .kiro/ SÍ es parte del desarrollo (specs, steering, hooks): se versiona.
# Solo se ignora el estado local/caché de la IDE.
.kiro/**/cache/
.kiro/**/*.local.*
